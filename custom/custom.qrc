<RCC>
    <qresource prefix="/custom/img">
        <file alias="dronecode-black.svg">res/Images/dronecode-black.svg</file>
        <file alias="dronecode-white.svg">res/Images/dronecode-white.svg</file>
    </qresource>
    <qresource prefix="/Custom/qmlimages">
        <file alias="PaperPlane.svg">res/Images/CustomVehicleIcon.svg</file>
    </qresource>
    <qresource prefix="/Custom/res">
        <file alias="QGCLogoFull.svg">res/icons/custom_qgroundcontrol.png</file>
        <file alias="QGCLogoWhite.svg">res/QGCLogoWhite.svg</file>
        <file alias="QGCLogoBlack.svg">res/QGCLogoBlack.svg</file>
        <file alias="qgroundcontrol.ico">res/icons/custom_qgroundcontrol.ico</file>
    </qresource>
    <qresource prefix="/Custom/settings">
        <file alias="CustomAppSettings.qml">src/UI/AppSettings/CustomAppSettings.qml</file>
        <file alias="CustomGeneralSettings.qml">src/UI/AppSettings/CustomGeneralSettings.qml</file>
        <file alias="CustomSettingsPagesModel.qml">src/UI/AppSettings/CustomSettingsPagesModel.qml</file>
    </qresource>
    <qresource prefix="/qml/QGroundControl/AppSettings">
        <file alias="GeneralSettings.qml">src/UI/AppSettings/CustomGeneralSettings.qml</file>
    </qresource>
</RCC>
